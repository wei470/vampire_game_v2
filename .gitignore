# ====================
# Unity .gitignore
# ====================

# Unity 自动生成的文件
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# 内存快照
/[Mm]emoryCaptures/

# 录制
/[Rr]ecordings/

# Asset 导入
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Visual Studio / Rider
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# macOS
.DS_Store
*.swp
*.lock
profile

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# TextMeshPro
/[Aa]ssets/TextMesh*Pro/

# Burst
[Bb]urst[Bb]uild[Bb]inary/